# ScholarTrack Environment Configuration Template

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=student_ledger

# API Security
STUDENTLEDGER_API_TOKEN=your_secure_api_token_here
SECRET_KEY=your_flask_secret_key_here

# Google Sheets Integration (Service Account)
GOOGLE_SERVICE_ACCOUNT_FILE=path/to/service_account_credentials.json
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Flask Configuration
FLASK_DEBUG=0
PORT=5000
MAX_STUDENTS=1000

